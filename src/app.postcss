:root {
	color: #2c2c2c;
	background: #f7f2e9;
	font-family:
		Inter,
		"IBM Plex Sans",
		"Helvetica Neue",
		Arial,
		"Hiragino Sans",
		"Yu Gothic",
		sans-serif;
	font-synthesis: none;
	text-rendering: optimizeLegibility;
	-webkit-font-smoothing: antialiased;
}

* {
	box-sizing: border-box;
}

html {
	min-height: 100%;
	scroll-behavior: smooth;
}

body {
	min-height: 100%;
	margin: 0;
	background:
		linear-gradient(180deg, rgba(139, 186, 20, 0.16), transparent 360px),
		#f7f2e9;
}

a {
	color: inherit;
	text-decoration-color: rgba(139, 186, 20, 0.55);
	text-decoration-thickness: 2px;
	text-underline-offset: 4px;
}

a:hover {
	text-decoration-color: #8bba14;
}

button,
input,
textarea,
select {
	font: inherit;
}

.page {
	width: min(1120px, calc(100vw - 32px));
	margin: 0 auto;
}

.section {
	padding: 56px 0;
}

.eyebrow {
	margin: 0 0 10px;
	color: #5c710f;
	font-size: 0.82rem;
	font-weight: 800;
	letter-spacing: 0;
	text-transform: uppercase;
}

.lead {
	color: #514c45;
	font-size: 1.08rem;
	line-height: 1.8;
}

.button {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 42px;
	padding: 0 18px;
	color: #ffffff;
	background: #373737;
	border: 1px solid #1f1f1f;
	border-radius: 6px;
	box-shadow: 0 2px 0 rgba(0, 0, 0, 0.28);
	font-weight: 800;
	text-decoration: none;
}

.button.primary {
	color: #1f1f1f;
	background: #8bba14;
	border-color: #6d930e;
}

.panel {
	background: rgba(255, 255, 255, 0.74);
	border: 1px solid rgba(55, 55, 55, 0.14);
	border-radius: 8px;
	box-shadow: 0 12px 36px rgba(44, 44, 44, 0.1);
}

.grid {
	display: grid;
	gap: 18px;
}

.grid.two {
	grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid.three {
	grid-template-columns: repeat(3, minmax(0, 1fr));
}

@media (max-width: 760px) {
	.page {
		width: min(100vw - 22px, 680px);
	}

	.section {
		padding: 34px 0;
	}

	.grid.two,
	.grid.three {
		grid-template-columns: 1fr;
	}
}
